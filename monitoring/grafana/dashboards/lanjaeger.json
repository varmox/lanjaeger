        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - max(lanjaeger_cache_filesystem_free_bytes) / max(lanjaeger_cache_filesystem_size_bytes)",
          "legendFormat": "Filesystem used",
          "refId": "B"
