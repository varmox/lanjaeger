# Copy to .env and edit:  cp .env.example .env
# .env is git-ignored, so `git pull` never conflicts with your settings.

# ── Network ─────────────────────────────────────────────────────────────

# IP(s) of this machine that clients should download from. Space-separated
# for several (e.g. "192.168.1.10 192.168.1.11") — helps Steam priming.
LANCACHE_IP=192.168.1.10

# The one IP the DNS service listens on. Hand this out as DNS server via DHCP.
DNS_BIND_IP=192.168.1.10

# Optional IPv6 DNS (see NETWORK.md): set both lines, then let your router
# announce DNS_BIND_IP6 as the IPv6 DNS server.
DNS_BIND_IP6=
#COMPOSE_FILE=docker-compose.yml:docker-compose.ipv6.yml

# Optional: bind the cache's HTTP/HTTPS ports to one IP instead of all.
CACHE_BIND_IP=

# Resolver for everything that isn't cached. Several: "192.168.1.1; 1.1.1.1"
# (semicolons — both containers understand that format). Point it at your
# router if you need local hostnames to resolve.
UPSTREAM_DNS=1.1.1.1

# Leave true for this single-container setup.
USE_GENERIC_CACHE=true

# ── Storage ─────────────────────────────────────────────────────────────

# Where cache and logs live. Use a dedicated disk, not the system disk.
CACHE_ROOT=./lancache

# Upper limit for cached data, in GIGABYTES with a "g" suffix ONLY.
# "4t" looks valid but breaks nginx — write 4000g (lancachenet/monolithic#213).
CACHE_DISK_SIZE=2000g

# Prune when free space drops below this, whatever CACHE_DISK_SIZE says.
MIN_FREE_DISK=10g

# Index memory: about 250m per 1000g of CACHE_DISK_SIZE.
CACHE_INDEX_SIZE=500m

# Maximum age of cached content.
CACHE_MAX_AGE=3650d

# ── Logs ────────────────────────────────────────────────────────────────

# Rotate a log once it exceeds this size (MB), keep this many gzipped copies.
LOG_MAX_SIZE_MB=1024
LOG_KEEP=7
LOG_CHECK_INTERVAL=3600

# ── Ad blocking ─────────────────────────────────────────────────────────

# Block ads/trackers for every device using this DNS (lists: blocky/).
# Enforced by the web UI (its switch writes this). Without the web UI,
# blocking is always on after a restart; switch it off until the next
# restart with: docker compose exec blocky /app/blocky blocking disable --groups ads
ADBLOCK_ENABLED=true

# ── Operation ───────────────────────────────────────────────────────────

# "no" while you're setting up; "unless-stopped" once it works, so the
# stack comes back after a reboot.
RESTART_POLICY=no

# Timezone for log timestamps (tz database name).
TZ=Europe/Zurich

# ── Web UI (optional) ───────────────────────────────────────────────────

# Uncomment to run the web UI (dashboard, restart/update, settings).
# It can control Docker on this machine: keep it on your LAN, use a strong password.
#COMPOSE_PROFILES=webui
WEBUI_PASSWORD=
WEBUI_PORT=8080
# Bind to one IP (e.g. your LAN IP) instead of all interfaces.
WEBUI_BIND_IP=
# true = anyone on the LAN can view the stats without signing in
# (controls always need the password) — handy on a screen at a LAN party.
WEBUI_PUBLIC_DASHBOARD=false

# ── Metrics and monitoring (optional, see MONITORING.md) ────────────────

# Token for the web UI's /metrics endpoint (Prometheus format, for Grafana,
# Telegraf, VCF Operations). Empty = endpoint off. Generate one with:
#   openssl rand -hex 24
METRICS_TOKEN=
# Telegraf + Prometheus + Grafana on this server: add "monitoring" to
# COMPOSE_PROFILES, e.g. COMPOSE_PROFILES=webui,monitoring
# (needs the web UI and METRICS_TOKEN).
GRAFANA_PORT=3000
# Bind Grafana to one IP; empty = WEBUI_BIND_IP.
GRAFANA_BIND_IP=
# Grafana's "admin" password; empty = WEBUI_PASSWORD.
GRAFANA_PASSWORD=
# true = dashboards viewable without signing in (e.g. on a screen).
GRAFANA_PUBLIC=false
# How long Prometheus keeps metrics.
METRICS_RETENTION=90d
# Group of the Docker socket, for container metrics: stat -c %g /var/run/docker.sock
DOCKER_GID=999

# Pin images here if you want reproducible updates, e.g.
# MONOLITHIC_IMAGE=lancachenet/monolithic@sha256:…
# DNS_IMAGE=lancachenet/lancache-dns@sha256:…
